<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recherche_du_tag"
        android:background="@color/colorBlueDark2"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:padding="10dp"
        android:orientation="vertical">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/geigerProgressLabelMin"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="20" />
            <TextView
                android:id="@+id/geigerProgressLabelMid"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="50" />
            <TextView
                android:id="@+id/geigerProgressLabelMax"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:textColor="@color/black"
                android:text="100" />
        </TableRow>

        <ProgressBar
            android:id="@+id/geigerProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:progressDrawable="@drawable/progress_gradient"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/geigerTagRssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="30sp"
            android:textColor="@color/black"
            android:text="0" />

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            style="@style/base_layout_style"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:orientation="vertical">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/default_left_padding">
                <TextView
                    android:layout_width="wrap_content"
                    android:gravity="right"
                    style="@style/style_normal_font"
                    android:text="Tag" />
                <include
                    android:id="@+id/selectTagID"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/custom_edittext" />
            </TableRow>

            <TableRow
                android:id="@+id/selectMemoryBankRow"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_top_margin"
                android:paddingLeft="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="left"
                    style="@style/style_normal_font"
                    android:text="Select bank" />
                <Spinner
                    android:id="@+id/selectMemoryBank"
                    android:layout_margin="0dp"
                    android:layout_weight="1"
                    style="@style/style_default_spinner" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:visibility="gone"
                    style="@style/style_normal_font"
                    android:text="Offset (bit)" />
                <EditText
                    android:id="@+id/selectMemoryOffset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:visibility="gone"
                    android:inputType="numberDecimal"
                    style="@style/style_normal_font"
                    android:text="32" />
            </TableRow>

            <TableRow
                android:id="@+id/selectPasswordRow"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/default_left_padding">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    style="@style/style_normal_font"
                    android:text="@string/password_title" />
                <include
                    android:id="@+id/selectPasswordValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    layout="@layout/custom_edittext_password" />
            </TableRow>

            <!-- Antenna Power Row with SeekBar -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingLeft="@dimen/default_left_padding"
                android:paddingRight="@dimen/default_left_padding">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:layout_height="wrap_content"
                    style="@style/style_normal_font"
                    android:text="@string/settingAntennaPower_title" />
                <TextView
                    android:id="@+id/selectAntennaPowerValue"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    style="@style/style_normal_font"
                    android:text="300" />
            </TableRow>

            <SeekBar
                android:id="@+id/selectAntennaPowerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="300"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <CheckBox
                android:id="@+id/geigerToneCheck"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tone" />
            <TextView
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="Threshold:" />
            <TextView
                android:id="@+id/geigerThreshold"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="0.00" />
        </TableRow>

        <SeekBar
            android:id="@+id/geigerSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/geigerRunTime"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:textSize="10dp"
            android:layout_height="wrap_content"
            android:gravity="left"/>
        <TextView
            android:id="@+id/geigerTagGot"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:gravity="center" />
        <TextView
            android:id="@+id/geigerVoltageLevel"
            android:layout_weight="1"
            android:textSize="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/geigerYield"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center" />
        <Button
            android:id="@+id/geigerStart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:text="Démarrer" />
        <Button
            android:id="@+id/closeButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_height="wrap_content"
            android:text="Fermer" />
        <TextView
            android:id="@+id/geigerRate"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>