<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mainRow1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/border">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="inventaireClicked"
                android:paddingBottom="40dp"
                android:src="@drawable/inventory"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/home_inventory710" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/border">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="settClicked"
                android:paddingBottom="40dp"
                android:src="@drawable/settings"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/home_settings710" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainRow3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            style="@style/DashboardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:text="Foreground Service in Action" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/border">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="connectClicked"
                android:paddingBottom="40dp"
                android:src="@drawable/connect"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/home_connect" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@drawable/border">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="aboutClicked"
                android:paddingBottom="40dp"
                android:src="@drawable/about"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="About" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>