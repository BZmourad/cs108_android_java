<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:orientation="vertical"
    android:layout_marginTop="?attr/actionBarSize"
    tools:context="honeywell.hedc_demoapp2.MainActivity">

    <TextView
        android:id="@+id/Connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center|right"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingStart="0dp"
        android:drawableStart="@drawable/honeywell"
        android:foregroundGravity="center"
        android:gravity="right|center_horizontal|center_vertical"
        android:text="@string/status"
        android:textColor="@color/colorText"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="2">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="126dp"
            android:layout_height="592dp"
            android:baselineAligned="true"

            android:fillViewport="true"
            android:paddingEnd="@dimen/activity_horizontal_margin"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="0dp">

                <ToggleButton
                    android:id="@+id/ToggleConnect"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:drawableStart="@drawable/ic_swap_calls_black_24dp"
                    android:text="@string/button_disconnect"
                    android:textAllCaps="false"
                    android:textOff="@string/button_connect"
                    android:textOn="@string/button_disconnect"
                    android:textSize="12sp" />

                <!--<Button
                    android:id="@+id/ScanOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:onClick="onClickScanOn"
                    android:drawableStart="@drawable/ic_play_arrow_black_24dp"
                    android:text="@string/Scanon"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/ScanOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:onClick="onClickScanOff"
                    android:drawableStart="@drawable/ic_stop_black_24dp"
                    android:text="@string/Scanoff"
                    android:textAllCaps="false" />-->

                <!-- <Button
                    android:id="@+id/Snapshot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:onClick="onClickGetNewImage"
                    android:drawableStart="@drawable/ic_camera_alt_black_24dp"
                    android:text="@string/Snapshot"
                    android:textAllCaps="false" />-->

                <!--<Button
                    android:id="@+id/ExistingImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:onClick="onClickExistingImage"
                    android:drawableStart="@drawable/ic_camera_roll_black_24dp"
                    android:text="@string/ExistingImage"
                    android:textAllCaps="false" />-->

                <Button
                    android:id="@+id/BeepSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:drawableStart="@drawable/ic_music_note_black_24dp"
                    android:onClick="onClickBeepSuccess"
                    android:text="@string/BeepSuccess"
                    android:textAllCaps="false"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/BeepError"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:drawableStart="@drawable/ic_music_note_black_24dp"
                    android:onClick="onClickBeepError"
                    android:text="@string/BeepError"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <!--<Spinner
                    android:id="@+id/Triggermode"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/dropdownListPreferredItemHeight"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:background="@drawable/spinner_bg"
                    android:popupElevation="3dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:prompt="@string/TrgMod" />-->

                <EditText
                    android:id="@+id/Cmd"
                    style="@style/InputTextView"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/editshape"
                    android:hint="@string/menucmd"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/SendCmd"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:drawableStart="@drawable/ic_send_black_24dp"
                    android:onClick="onClickSend"
                    android:text="@string/Send"
                    android:textAllCaps="false"
                    android:textSize="12sp"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@style/CustomProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/activity_progress_height"
                    android:layout_marginTop="@dimen/button_margin"
                    android:layout_marginBottom="@dimen/button_margin"
                    android:progress="0"
                    android:progressBackgroundTint="@color/colorTextBackground"
                    android:progressTint="?attr/colorPrimary"
                    tools:layout_gravity="center_vertical" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/fragment_container"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingEnd="@dimen/activity_horizontal_margin"
            android:weightSum="2">

            <FrameLayout
                android:id="@+id/header_container"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1" >
            </FrameLayout>

            <FrameLayout
                android:id="@+id/details_container"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:paddingEnd="@dimen/activity_horizontal_margin" >
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>


</LinearLayout>
</ScrollView>