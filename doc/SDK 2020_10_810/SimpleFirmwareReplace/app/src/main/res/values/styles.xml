<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:actionButtonStyle">@style/CustomActionButtonStyle</item>
        <item name="android:buttonStyle">@style/CustomButton</item>
        <item name="android:progressBarStyle">@style/CustomProgressBar</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- More distance between menu icons. -->
    <style name="CustomActionButtonStyle" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:minWidth">70dp</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CustomProgressBar" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/progressshape</item>

        <item name="android:progressBackgroundTint">@color/colorTextBackground</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
        <item name="android:secondaryProgressTint">?attr/colorAccent</item>
        <item name="android:layout_margin">@dimen/button_margin</item>
    </style>

    <style name="CustomButton" parent="android:Widget.Button">
        <item name="android:background">@drawable/buttonshape</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat</item>
        <item name="android:layout_margin">@dimen/button_margin</item>
    </style>

    <style name="InputTextView" parent="android:Widget.TextView">
        <item name="android:background">@drawable/editshape</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">sans</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>
